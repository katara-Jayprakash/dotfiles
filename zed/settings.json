{
  "vim_mode": false,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "JetBrains Dark Blur",
  },
  "buffer_font_family": "JetBrains Mono NL",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "icon_theme": "Material Icon Theme",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "languages": {
    "JavaScript": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ],
        },
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "format_on_save": "on",
    },
    "Python": {
      "language_servers": [
        "ruff",
        "pylsp"
      ],
      "preferred_line_length": 120,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": [
            "format",
            "-"
          ]
        }
      }
    },
    "TypeScript": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--stdin-filepath",
            "{buffer_path}"
          ],
        },
      },
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
    "Go": {
      "hard_tabs": true,
    },
    // "Make": {
    //   "hard_tabs": true,
    // },
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "keyOrdering": false,
          "format": {
            "singleQuote": false,
          },
          "schemas": {},
        },
      },
    },
    "pylsp": {
      "settings": {
        "pylsp": {
          "plugins": {
            "ruff": {
              "enabled": true
            },
            "pyflakes": { // Disable since Ruff handles this
              "enabled": false
            },
            "pycodestyle": { // Disable since Ruff handles this
              "enabled": false
            },
            "mccabe": {
              "enabled": false
            },
            "autopep8": {
              "enabled": false
            },
            "yapf": {
              "enabled": false
            }
          }
        }
      }
    },
    // "file_types": {
    //   "Helm": [
    //     "**/templates/*.yaml",
    //     "**/templates/*.yml"
    //   ],
    // },
  },
  "hard_tabs": false,
  "formatter": "language_server",
  "format_on_save": "on",
  "project_panel": {
    "folder_indicator": "chevron",
    "indent_size": 10,
    "default_width": 200,
    "entry_spacing": "comfortable",
    "file_icons": true,
    "auto_fold_dirs": false,
    "auto_reveal_entries": true,
    "button": true,
    "dock": "right",
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show": true,
    "show_nav_history_buttons": false,
  },
  "centered_layout": {
    "left_padding": 0.15,
    "right_padding": 0.15,
  },
  "inlay_hints": {
    "enabled": false,
  },
  "soft_wrap": "editor_width",
  "edit_predictions": {
    "provider": "none",
    "disabled_globs": [],
  },
  "scrollbar": {
    "git_diff": false,
    "search_results": false,
    "selected_symbol": false,
    "diagnostics": "error",
  },
  "search": {
    "case_sensitive": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null,
    },
    "include_warnings": false,
  },
  "gutter": {
    "line_numbers": true,
    // "code_actions": false,
    "runnables": false,
    "folds": true,
  },
  "preview_tabs": {
    "enabled": false,
    // "enable_preview_from__file_finder": false,
    "enable_keep_preview_on_code_navigation": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "agent": {
    "enabled": false,
  },
  "outline_panel": {
    "button": false,
  },
  "collaboration_panel": {
    "button": false,
  },
  "line_indicator_format": "short",
  "terminal": {
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": [
          "-l"
        ]
      }
    },
    "working_directory": "current_project_directory",
    "dock": "bottom",
    "default_width": 640,
    "default_height": 320,
    "blinking": "terminal_controlled",
    "cursor_shape": null,
    "alternate_scroll": "off",
    "option_as_meta": false,
    "copy_on_select": true,
    "button": true,
    "line_height": "comfortable",
    "toolbar": {
      "breadcrumbs": false
    }
  }
}
